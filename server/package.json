    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
