# ==================== DATABASE ====================
# PostgreSQL connection string used by Prisma (server/prisma/schema.prisma)
DATABASE_URL="postgresql://sih_user:sih_password@localhost:5432/sih26101?schema=public"

# ==================== SERVER ====================
# PORT is injected automatically by Railway; 5000 is the local fallback.
PORT=5000
NODE_ENV=development
# Origin(s) of the deployed frontend, comma-separated, no trailing slash.
# Production example: FRONTEND_URL="https://your-app.vercel.app"
# (CLIENT_URL is still read as a legacy alias.) localhost:5173 is allowed automatically
# when NODE_ENV is not "production".
FRONTEND_URL="http://localhost:5173"

# ==================== AUTH ====================
# Production: 32+ random chars, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# ==================== AI PROVIDER ====================
# "demo" uses the built-in DemoAIProvider (no external API key required, always works for the hackathon demo).
# "external" routes to a real LLM provider — requires EXTERNAL_AI_API_KEY below.
AI_PROVIDER=demo
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_MODEL=

# ==================== FILE UPLOADS ====================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="uploads"

# ==================== iGOT KARMAYOGI (future live integration) ====================
# Left blank in the prototype. When authorized credentials are available, igotService
# can be switched from the prototype catalog to these live endpoints without frontend changes.
IGOT_API_BASE_URL=
IGOT_API_KEY=

# ==================== FRONTEND (client/.env, Vite) ====================
# Not used by the backend. See client/.env.example. Never put secrets in VITE_* variables.
