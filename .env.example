# ==================== DATABASE ====================
# PostgreSQL connection string used by Prisma (server/prisma/schema.prisma)
DATABASE_URL="postgresql://sih_user:sih_password@localhost:5432/sih26101?schema=public"

# ==================== SERVER ====================
# PORT is injected automatically by Railway; 5000 is the local fallback.
PORT=5000
NODE_ENV=development
# Origin(s) of the deployed frontend, comma-separated, no trailing slash.
# Production example: FRONTEND_URL="https://your-app.vercel.app"
# (CLIENT_URL is still read as a legacy alias.) localhost:5173 is allowed automatically
# when NODE_ENV is not "production".
FRONTEND_URL="http://localhost:5173"

# ==================== AUTH ====================
# Production: 32+ random chars, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# Login brute-force protection (all optional; defaults shown). Only FAILED attempts count.
# LOGIN_RATE_LIMIT_MAX      failed attempts per IP + email per window before HTTP 429
# LOGIN_IP_RATE_LIMIT_MAX   failed attempts per IP (any email) per window
# REGISTER_RATE_LIMIT_MAX   sign-ups per IP per hour
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=5
LOGIN_IP_RATE_LIMIT_MAX=30
REGISTER_RATE_LIMIT_MAX=20

# ==================== GOOGLE SIGN-IN (OAuth 2.0 / OpenID Connect) ====================
# Create these in Google Cloud Console - see docs/google-oauth-setup.md.
# Server-side ONLY. Never copy these into client/.env or any VITE_* variable.
# If any of the three is empty, "Continue with Google" reports that Google sign-in is unavailable
# and email/password login keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an "Authorized redirect URI" in Google Cloud. It points at the BACKEND.
# Local:      http://localhost:5000/api/auth/google/callback
# Production: https://<your-backend>.up.railway.app/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
# After Google finishes, users are sent to the first origin in FRONTEND_URL.

# ==================== EMAIL / PASSWORD RESET ====================
# Password reset only works when an email provider is configured; otherwise "Forgot password?" says recovery
# is unavailable (nothing is ever sent or faked). Secrets belong in Railway variables only.
#   EMAIL_PROVIDER=resend        (or leave unset for no email)
#   EMAIL_API_KEY=               provider API key
#   EMAIL_FROM="SIH26101 <no-reply@your-domain>"   must be a sender your provider has verified
# Development only:  EMAIL_PROVIDER=console  prints the message (including the reset link) to your local terminal.
# Optional tuning (defaults shown):
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3
# PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3   (per IP + email)   PASSWORD_RESET_IP_LIMIT_PER_HOUR=15   PASSWORD_RESET_ATTEMPT_LIMIT=10
# The reset link points at the first origin in FRONTEND_URL.

# ==================== DEMO ACCOUNTS ====================
# Seeded @demo.gov.in accounts have publicly documented passwords. Unset = enabled in development,
# BLOCKED in production. Set true only for a supervised demonstration. Accounts are never deleted;
# this only controls whether they can sign in.
# DEMO_ACCOUNTS_ENABLED=false

# ==================== AI PROVIDER ====================
# "demo" uses the built-in DemoAIProvider (no external API key required, always works for the hackathon demo).
# "external" routes to a real LLM provider — requires EXTERNAL_AI_API_KEY below.
AI_PROVIDER=demo
# For real AI set AI_PROVIDER=external and configure (Railway variables only - never in client/.env):
#   AI_BASE_URL   OpenAI-compatible base URL, e.g. https://api.openai.com/v1
#   AI_API_KEY    provider API key
#   AI_MODEL      model name, e.g. gpt-4o-mini
# (The older EXTERNAL_AI_BASE_URL / EXTERNAL_AI_API_KEY / EXTERNAL_AI_MODEL names still work.)
# Optional tuning:
#   AI_TIMEOUT_MS=30000  AI_MAX_RETRIES=2  AI_MAX_OUTPUT_TOKENS=2500  AI_MAX_INPUT_CHARS=12000
# With AI_PROVIDER=external, document analysis and MCQ generation NEVER fall back to demo output; they return a
# 503 "AI unavailable" instead. Only the assistant may fall back, and it is labelled as a fallback.

# Daily per-user AI quotas (rolling 24 hours, enforced on the server; defaults shown)
AI_DAILY_ANALYSES_PER_USER=20
AI_DAILY_MCQ_GENERATIONS_PER_USER=20
AI_DAILY_ASSISTANT_MESSAGES_PER_USER=100
# AI_QUOTAS_ENABLED=false   # disables quota enforcement (development only)

# Per-minute, per-user limits for expensive actions (defaults shown)
UPLOAD_RATE_LIMIT_PER_MINUTE=10
AI_JOB_RATE_LIMIT_PER_MINUTE=10
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_MODEL=
# Karmayogi AI Assistant: max chat messages per learner per minute (default 20).
ASSISTANT_RATE_LIMIT_PER_MINUTE=20

# ==================== FILE UPLOADS / STORAGE ====================
MAX_UPLOAD_SIZE_MB=10
# Uploaded files are kept on a Railway VOLUME (persistent). Attach a Volume to the backend service; Railway then
# sets RAILWAY_VOLUME_MOUNT_PATH automatically and files are stored under <mount>/uploads. Or set the folder yourself:
# STORAGE_ROOT=/data/uploads
# In production the app REFUSES to store files unless one of these is set (it will not use the ephemeral disk).
# STORAGE_ALLOW_EPHEMERAL=true   # explicit, NOT recommended: files are lost on every redeploy
# STORAGE_PROVIDER=volume        # the only provider today; an S3-compatible one can be added later without app changes
# In development, files go to server/uploads when none of the above is set.
# Per-minute, per-user limit on downloading/deleting stored files (default 30)
# FILE_ACCESS_RATE_LIMIT_PER_MINUTE=30
# (UPLOAD_DIR is no longer used except to find/remove files uploaded before persistent storage existed.)
UPLOAD_DIR="uploads"

# ==================== iGOT KARMAYOGI (future live integration) ====================
# Left blank in the prototype. When authorized credentials are available, igotService
# can be switched from the prototype catalog to these live endpoints without frontend changes.
IGOT_API_BASE_URL=
IGOT_API_KEY=

# ==================== FRONTEND (client/.env, Vite) ====================
# Not used by the backend. See client/.env.example. Never put secrets in VITE_* variables.
