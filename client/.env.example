# Backend origin used by the frontend at build time (Vercel: Project > Settings > Environment Variables).
# Leave UNSET for local development - requests go to /api and are proxied to localhost:5000 by vite.config.js.
# Production example (no trailing slash; "/api" is appended automatically if missing):
# VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=
